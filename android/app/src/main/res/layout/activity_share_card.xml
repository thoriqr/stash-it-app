<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/share_card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:fillViewport="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/share_card_background"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/share_eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="@string/share_card_eyebrow"
            android:textColor="@color/share_accent"
            android:textSize="9.5sp" />

        <TextView
            android:id="@+id/share_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/share_card_title"
            android:textColor="@color/share_text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/share_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/share_text_secondary"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/share_note_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:letterSpacing="0.12"
            android:text="@string/share_card_note_label"
            android:textColor="@color/share_text_tertiary"
            android:textSize="9.5sp" />

        <EditText
            android:id="@+id/share_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/share_note_field"
            android:hint="@string/share_card_note_hint"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLength="5000"
            android:maxLines="4"
            android:minLines="2"
            android:padding="12dp"
            android:textColor="@color/share_text_primary"
            android:textColorHint="@color/share_text_tertiary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/share_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/share_text_secondary"
            android:textSize="11.5sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="end"
            android:orientation="horizontal">

            <Button
                android:id="@+id/share_cancel"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="@string/share_card_cancel"
                android:textAllCaps="false"
                android:textColor="@color/share_text_secondary"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/share_save"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/share_primary_button"
                android:foreground="?android:attr/selectableItemBackground"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="88dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:stateListAnimator="@null"
                android:text="@string/share_card_save"
                android:textAllCaps="false"
                android:textColor="@color/share_button_text_state"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
